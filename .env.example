# ==========================================
# SANJHI PLATFORM — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# Server & Application Configuration
# ------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------
# Option A: Full Connection String (e.g. Supabase, Neon, Railway)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sanjhi_db

# Option B: Individual Local DB Parameters (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=sanjhi_db
DB_SSL=false

# ------------------------------------------
# Security & JWT Authentication
# ------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_key_here

# Super Admin Initializer
ADMIN_EMAIL=admin@sanjhi.pk
ADMIN_PHONE=03000000000
ADMIN_PASSWORD=Admin@Sanjhi2026

# ------------------------------------------
# Groq AI & Voice Intelligence
# ------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# OpenRouter (Fallback AI LLM)
# ------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------
# Email & OTP Service (SMTP / Resend / Brevo)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="Sanjhi AI" <no-reply@sanjhi.pk>

# Optional: Resend API
RESEND_API_KEY=
RESEND_FROM=Sanjhi <onboarding@resend.dev>

# Optional: Brevo API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@sanjhi.pk
BREVO_SENDER_NAME=Sanjhi

# ------------------------------------------
# WhatsApp AI Gateway & External Services
# ------------------------------------------
ENABLE_WHATSAPP_GATEWAY=true
# Optional Green API / CallMeBot for Fallback OTP:
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN_INSTANCE=
CALLMEBOT_API_KEY=

# ------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_WHATSAPP_NUMBER=923001234567
